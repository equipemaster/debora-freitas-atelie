# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# (Supabase > Project Settings > API)

# URL do projeto — ex.: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Chave anônima (pública). A RLS do Postgres é quem protege os dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SOMENTE no servidor (Edge Functions, rotas internas).
# Nunca exponha no cliente nem faça commit do valor real.
SUPABASE_SERVICE_ROLE_KEY=

# Base pública do app, usada para montar links de revisão.
NEXT_PUBLIC_APP_URL=http://localhost:3000
